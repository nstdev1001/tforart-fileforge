{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tforart FileForge",
  "version": "0.2.2",
  "identifier": "com.tforart.fileforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tforart FileForge",
        "width": 1240,
        "height": 780,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://*.googleusercontent.com https://*.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Utility",
    "shortDescription": "Task manager and file automation tool",
    "longDescription": "Compress, upload, download, extract, and automate file workflows from one Windows desktop application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Q0U1Qjg3QTdFMDI4MDYKUldRR0tPQ25oMXZPcUJRYXRPbnkxbGVjaTAzQzkzeEc0MW1qTDd0cVBreS94MHo1MTdYeWdkeVkK",
      "endpoints": [
        "https://github.com/nstdev1001/tforart-fileforge/releases/latest/download/latest.json"
      ]
    }
  }
}
